# Hugo build output and caches. The site is built in CI by
# .github/workflows/deploy.yml; nothing here is source.
/public/
/resources/
.hugo_build.lock

# OS noise
.DS_Store

# NOT ignored, and deliberately so:
#   static/captures/**  — the generated cell-grid captures. They are build
#     artefacts of the framework repo (cmd/capture), committed here unmodified so
#     this site builds without a framework checkout and so the exact frames are
#     reviewable in a diff. scripts/check_captures.sh verifies they are untouched.
#   data/godoc.json     — godoc extracted from the framework, cached so the widget
#     pages can be regenerated without a framework checkout.
#   content/widgets/**  — GENERATED by scripts/gen_widgets.py and committed.
#     The plan (docs/SITE-PLAN.md §1.3) proposed git-ignoring generated content;
#     it is committed here instead because the widget pages carry hand-written
#     prose from data/widget_prose.json and a reader reviewing a widget page in
#     the repository should see the whole file.